---
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import AgentRow from "@/components/AgentRow.astro";
import { agentsByFramework, frameworkCounts } from "@/lib/catalog";
import { FRAMEWORKS, FRAMEWORK_BY_SLUG } from "@/lib/frameworks";

export function getStaticPaths() {
  return FRAMEWORKS.map((f) => ({ params: { slug: f.slug } }));
}

const { slug } = Astro.params;
const fw = FRAMEWORK_BY_SLUG[slug!];
if (!fw) throw new Error(`Unknown framework: ${slug}`);

const agents = agentsByFramework(slug!);
const runnableCount = agents.filter((a) => a.runnable).length;
const counts = frameworkCounts();
---

<Base
  current=""
  title={`${fw.name} agents — ONEXUS-Agents`}
  description={`${agents.length} ${fw.name}-based agents indexed across ${new Set(agents.map((a) => a.category)).size} categories.`}
>
  <div class="max-w-7xl mx-auto px-6 py-12">
    <a href="/catalog" class="inline-flex items-center gap-1.5 text-sm font-mono text-[var(--color-fg-dim)] hover:text-[var(--color-accent)] mb-6">
      <Icon name="arrow-left" size="sm" />
      All categories
    </a>

    <header class="flex items-start gap-5 mb-10">
      <span class="inline-flex items-center justify-center w-14 h-14 rounded-lg border border-[var(--color-border)] text-[var(--color-accent)]">
        <Icon name={fw.glyph} size="xl" />
      </span>
      <div class="flex-1">
        <div class="font-mono text-xs text-[var(--color-fg-mute)] uppercase tracking-wider mb-1">framework · {fw.slug}</div>
        <h1 class="text-3xl font-bold mb-2">{fw.name}</h1>
        <p class="text-[var(--color-fg-dim)] max-w-2xl">{fw.description}</p>

        <div class="mt-4 flex flex-wrap items-center gap-2">
          <span class="badge"><Icon name="list" size="sm" />{agents.length} agents</span>
          {runnableCount > 0 && (
            <span class="badge badge-accent"><Icon name="play" size="sm" />{runnableCount} runnable</span>
          )}
          <a href={fw.url} target="_blank" rel="noopener" class="badge hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]">
            <Icon name="github" size="sm" />{fw.url.replace(/^https?:\/\//, "")}
            <Icon name="external-link" size="sm" />
          </a>
        </div>
      </div>
    </header>

    {agents.length > 0 ? (
      <>
      <div class="panel overflow-hidden">
        <table class="w-full">
          <thead>
            <tr class="border-b border-[var(--color-border)] bg-[var(--color-panel-2)]">
              <th class="px-4 py-2 text-right font-mono text-[11px] uppercase tracking-wider text-[var(--color-fg-mute)] w-12">#</th>
              <th class="w-10"></th>
              <th class="px-3 py-2 text-left font-mono text-[11px] uppercase tracking-wider text-[var(--color-fg-mute)]">Agent</th>
              <th class="px-3 py-2 text-right font-mono text-[11px] uppercase tracking-wider text-[var(--color-fg-mute)]">Stars</th>
              <th class="px-3 py-2 text-right font-mono text-[11px] uppercase tracking-wider text-[var(--color-fg-mute)] hidden md:table-cell">Last commit</th>
              <th class="px-3 py-2 text-right font-mono text-[11px] uppercase tracking-wider text-[var(--color-fg-mute)]">Score</th>
              <th class="px-3 py-2 text-right font-mono text-[11px] uppercase tracking-wider text-[var(--color-fg-mute)]">Links</th>
            </tr>
          </thead>
          <tbody data-agent-rows>
            {agents.map((a, i) => <AgentRow agent={{ ...a, rank_in_category: i + 1 }} showCategory={true} />)}
          </tbody>
        </table>
      </div>

      {agents.length > 100 && (
        <div class="mt-6 flex items-center justify-between">
          <div class="font-mono text-xs text-[var(--color-fg-mute)]">
            Showing <span data-shown-count>100</span> of {agents.length}
          </div>
          <button
            type="button"
            data-load-more
            class="inline-flex items-center gap-2 px-4 py-2 rounded-md border border-[var(--color-border)] text-[var(--color-fg-dim)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)] font-mono text-sm transition-colors"
          >
            <Icon name="arrow-right" size="sm" />
            Load 100 more
          </button>
        </div>
      )}

      <script is:inline>
        (() => {
          const PAGE_SIZE = 100;
          const tbody = document.querySelector("[data-agent-rows]");
          const button = document.querySelector("[data-load-more]");
          const counter = document.querySelector("[data-shown-count]");
          if (!tbody) return;
          const rows = Array.from(tbody.querySelectorAll("tr"));
          let shown = PAGE_SIZE;
          const apply = () => {
            rows.forEach((r, i) => { r.style.display = i < shown ? "" : "none"; });
            if (counter) counter.textContent = String(Math.min(shown, rows.length));
            if (button && shown >= rows.length) button.style.display = "none";
          };
          apply();
          if (button) button.addEventListener("click", () => { shown += PAGE_SIZE; apply(); });
        })();
      </script>
      </>
    ) : (
      <div class="panel p-8 text-center text-[var(--color-fg-dim)]">
        <Icon name="sparkles" class="mx-auto mb-3 text-[var(--color-fg-mute)]" />
        <p>No agents detected for this framework yet. The weekly rescan reads README content and may surface some.</p>
      </div>
    )}

    <section class="mt-16 pt-12 border-t border-[var(--color-border)]">
      <h2 class="font-mono text-xs text-[var(--color-fg-mute)] uppercase tracking-wider mb-4">Browse another framework</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
        {FRAMEWORKS.filter((f) => f.slug !== slug).map((f) => (
          <a href={`/framework/${f.slug}`} class="panel p-3 flex items-center justify-between hover:border-[var(--color-accent)] transition-colors group">
            <span class="font-mono text-sm text-[var(--color-fg)] group-hover:text-[var(--color-accent)]">{f.name}</span>
            <span class="font-mono text-xs text-[var(--color-fg-mute)]">{counts[f.slug] ?? 0}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>
